<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline preview of the procedural art: runs the real ArtRecipes on .NET and writes a PNG sheet. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>NU1701;CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/ProceduralArt.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/ProceduralArt.Menu.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/ProceduralArt.Content.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/ProceduralArt.Lobby.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/ProceduralArt.EnemyShots.cs" />
    <Compile Include="../../../Assets/_Project/Scripts/Editor/SetupUtil.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="../.cache/sdk/lib/UnityEditor.dll" />
    <Reference Include="../.cache/sdk/lib/UnityEngine.dll" />
  </ItemGroup>
</Project>
